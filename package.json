{
  "name": "@gepetto/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript / JavaScript SDK of the Gepetto API v2: real estate photo editing (enhance, declutter, furnish, sky, restyle, walls and floors, upscale).",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "ids": "node scripts/generate-ids.mjs",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-version.mjs src/index.ts && git add src/index.ts"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "gepetto",
    "real-estate",
    "virtual-staging",
    "photo-editing",
    "image-enhancement",
    "api",
    "sdk"
  ],
  "homepage": "https://docs.gepettoapp.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gepetto-AI/gepetto-sdk.git"
  }
}
